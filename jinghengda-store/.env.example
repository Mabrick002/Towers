# Copy this file to .env and fill in the values.  Never commit .env.

# --- Server ------------------------------------------------------------
NODE_ENV=production
PORT=3000
# Public address of the store (used for payment return links).
SITE_URL=https://jinghengdainternational.com
# Set to true when running behind a reverse proxy / load balancer (Nginx, Render, Railway…)
TRUST_PROXY=true

# --- Data --------------------------------------------------------------
DATABASE_FILE=data/store.db
UPLOAD_DIR=uploads

# --- Admin login (created on first start) -------------------------------
ADMIN_EMAIL=admin@jinghengdainternational.com
ADMIN_PASSWORD=choose-a-long-unique-password
ADMIN_NAME=Liu Zheng

# --- Store -------------------------------------------------------------
STORE_CONTACT_EMAIL=orders@jinghengdainternational.com
# Shipping in cents: $12.00 flat, free from $150.00
SHIPPING_FLAT_CENTS=1200
FREE_SHIPPING_THRESHOLD_CENTS=15000

# --- Payments ----------------------------------------------------------
# manual = orders are placed unpaid and you send payment instructions (default)
# stripe = customers pay by card on Stripe Checkout
# paypal = placeholder, see src/payments/paypal.js
PAYMENT_PROVIDER=manual

# Stripe (https://dashboard.stripe.com/apikeys)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# PayPal (https://developer.paypal.com/dashboard/applications)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox
