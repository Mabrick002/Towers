{
  "name": "jinghengda-store",
  "version": "1.0.0",
  "private": true,
  "description": "E-commerce fragrance store and admin dashboard for Jinghengda International Limited",
  "main": "server.js",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning server.js",
    "dev": "node --disable-warning=ExperimentalWarning --watch server.js",
    "seed": "node --disable-warning=ExperimentalWarning scripts/seed.js",
    "reset-db": "node --disable-warning=ExperimentalWarning scripts/seed.js --reset",
    "images": "node scripts/generate-images.js",
    "test": "playwright test",
    "set-password": "node --disable-warning=ExperimentalWarning scripts/set-admin-password.js"
  },
  "dependencies": {
    "express": "^5.2.1",
    "multer": "^2.0.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0"
  }
}
